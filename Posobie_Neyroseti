<script>
// Анализатор промптов
function analyzePrompt(){
  const text = document.getElementById('promptInput').value.trim().toLowerCase();
  const resultDiv = document.getElementById('promptResult');
  
  if(!text){
    resultDiv.style.display='block';
    resultDiv.innerHTML='<p style="color:var(--danger)">⚠️ Введите текст промпта!</p>';
    return;
  }
  
  // Критерии
  const roleWords = ['ты —','ты -','как ','в роли','представь себя','действуй как','роль:','специалист','эксперт','разработчик','учитель','учёный','дизайнер','программист','python','python-'];
  const contextWords = ['нужно','необходимо','задача','цель','проблема','создать','написать','сделать','разработать','помоги','мне нужно','для того чтобы','чтобы'];
  const formatWords = ['формат','стиль','на русском','на казахском','на английском','без','не используй','используй','комментарии','пример','пошагово','с объяснением','подробно','кратко','структурированно','в виде','список','таблица','код','программа','не более','не менее','объём','длина','ограничени'];
  
  const hasRole = roleWords.some(w => text.includes(w));
  const hasContext = contextWords.some(w => text.includes(w));
  const hasFormat = formatWords.some(w => text.includes(w));
  
  let score = 0;
  if(hasRole) score++;
  if(hasContext) score++;
  if(hasFormat) score++;
  
  const length = text.length;
  let lengthBonus = '';
  if(length < 30) lengthBonus = '<p style="color:var(--warning)">⚠️ Промпт слишком короткий. Добавьте больше деталей.</p>';
  else if(length > 100) lengthBonus = '<p style="color:var(--success)">✅ Хорошая длина промпта — достаточно деталей.</p>';
  
  let grade = '';
  let gradeColor = '';
  if(score === 3){ grade = '🏆 ОТЛИЧНО! Идеальный промпт'; gradeColor = 'var(--success)'; }
  else if(score === 2){ grade = '✅ ХОРОШО, но можно улучшить'; gradeColor = 'var(--accent2)'; }
  else if(score === 1){ grade = '⚠️ СЛАБО. Нужно доработать'; gradeColor = 'var(--warning)'; }
  else { grade = '❌ ОЧЕНЬ СЛАБО. Промпт неструктурирован'; gradeColor = 'var(--danger)'; }
  
  resultDiv.style.display='block';
  resultDiv.innerHTML = `
    <h4 style="color:var(--neon)">📋 Результат анализа:</h4>
    <div class="check-item ${hasRole?'ok':'no'}">
      ${hasRole?'✅':'❌'} <strong>Роль:</strong> ${hasRole?'роль задана':'укажите, кем должна быть нейросеть (напр. "Ты — опытный Python-разработчик...")'}
    </div>
    <div class="check-item ${hasContext?'ok':'no'}">
      ${hasContext?'✅':'❌'} <strong>Контекст:</strong> ${hasContext?'задача описана':'укажите цель и задачу (напр. "Мне нужно написать программу...")'}
    </div>
    <div class="check-item ${hasFormat?'ok':'no'}">
      ${hasFormat?'✅':'❌'} <strong>Ограничения/Формат:</strong> ${hasFormat?'формат указан':'добавьте требования к результату (напр. "с комментариями на русском")'}
    </div>
    ${lengthBonus}
    <div class="score" style="color:${gradeColor}">Оценка: ${score}/3 — ${grade}</div>
  `;
}

// Калькулятор ИМТ
function calcIMT(){
  const h = parseFloat(document.getElementById('height').value);
  const w = parseFloat(document.getElementById('weight').value);
  const res = document.getElementById('imtResult');
  
  if(!h || !w || h<100 || w<20){
    res.innerHTML='<span style="color:var(--danger)">⚠️ Введите корректные данные</span>';
    return;
  }
  
  const hm = h/100;
  const imt = (w / (hm*hm)).toFixed(1);
  
  let category='', color='';
  if(imt<18.5){ category='Недостаточный вес'; color='var(--accent2)'; }
  else if(imt<25){ category='✅ Нормальный вес'; color='var(--success)'; }
  else if(imt<30){ category='Избыточный вес'; color='var(--warning)'; }
  else { category='Ожирение'; color='var(--danger)'; }
  
  res.innerHTML = `
    <p><strong>Ваш ИМТ:</strong> <span style="color:var(--neon);font-size:1.5rem">${imt}</span></p>
    <p><strong>Категория:</strong> <span style="color:${color};font-weight:bold">${category}</span></p>
    <p style="color:var(--muted);font-size:0.9rem;margin-top:10px">Формула: ИМТ = вес(кг) / рост(м)²</p>
  `;
}
</script>

